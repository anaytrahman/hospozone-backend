# Copy this file to ".env" (same folder), fill the values, SAVE, then run: npm run seed
PORT=5000

# Atlas → Connect → Drivers → copy the string. Replace <username> and <password>
# (remove the < > brackets!). Keep "/hospozone" before the "?".
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hospozone?retryWrites=true&w=majority

# Any long random text
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h

CLIENT_URL=http://localhost:4200
